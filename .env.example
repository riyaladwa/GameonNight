# ============================================================================
# GOOGLE PLAY ARENA – GAME ON NIGHT
# BACKEND ENVIRONMENT CONFIGURATION (MONGODB & AUTH)
# ============================================================================

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/google_play_arena
MONGODB_DB_NAME=google_play_arena

# Administrator Credentials (Used to access the private admin control panel)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=gsa_admin_2026

# JWT Secret for signing administrator session tokens
JWT_SECRET=gsa_arena_jwt_production_secret_key_change_me_2026

# Backend Server Port (Default: 5001 - Avoids macOS AirPlay port 5000)
PORT=5001
